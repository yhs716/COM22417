# 공개 예시입니다. 학번·이름은 students.json에 본인 정보만 입력합니다.
# DB_USER·DB_PASSWORD는 작업 계정 확인 성공 후 저장합니다. 비밀번호를 공유하지 마세요.
DB_USER=
DB_PASSWORD=
DB_DSN=pcuora_low
# 수업용 공통 Wallet 암호입니다. 개인 DB 로그인 비밀번호와 다릅니다.
WALLET_PASSWORD=Pcuora2026
WALLET_ZIP=security/Wallet_PCUORA.zip
# 기본 Thin: Oracle Client 설치 없이 Wallet 비밀번호를 사용합니다.
# 외부 설치자료로 Thick Client를 준비한 경우에만 실제 Client 폴더를 지정합니다.
ORACLE_CLIENT_LIB=
